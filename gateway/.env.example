PORT=8793
GATEWAY_BASIC_USER=demo-agent
GATEWAY_BASIC_PASSWORD=replace-with-a-local-secret

# Browser credentials used only by the Gateway debug console's demo buttons.
VITE_MAAT_GATEWAY_BASIC_USER=demo-agent
VITE_MAAT_GATEWAY_BASIC_PASSWORD=replace-with-a-local-secret

# Server-only treasury signer. Never expose this through VITE_ variables.
MAAT_TREASURY_PRIVATE_KEY=

# Merchant resource contacted by the Gateway. Use the local URL for development
# or the deployed Merchant URL when the services run behind separate hosts.
MERCHANT_URL=https://merchant.maat-jev-gate.online/vendor/atlas/dataset/demo-1
# Optional timeout for the upstream merchant request.
MERCHANT_TIMEOUT_MS=15000

# Direct TypeSafe System One endpoint used by the Gateway process.
JEV_API_URL=https://api.typesafe.ai/v1/systemone
JEV_API_KEY=
JEV_MODEL=jev-latest

# World ID for Agents OIDC settings.
WORLD_ISSUER=https://sandbox.auth.world.org
WORLD_CLIENT_ID=
WORLD_CLIENT_SECRET=
WORLD_REDIRECT_URI=http://localhost:8787/auth/world/callback

# Deployment target used by deploy.mjs. The public domain is fixed in Caddy.
DEPLOY_HOST=
