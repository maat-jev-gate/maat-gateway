{
  "name": "maat-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"tsx watch server.ts\" \"vite --host 0.0.0.0\"",
    "build": "tsc -b && vite build",
    "start": "tsx server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "deploy": "node deploy.mjs"
  },
  "dependencies": {
    "@fastify/cors": "latest",
    "@fastify/static": "latest",
    "concurrently": "latest",
    "dotenv": "latest",
    "fastify": "latest",
    "jose": "latest",
    "viem": "latest",
    "react": "latest",
    "react-dom": "latest",
    "tsx": "^4.23.15",
    "vite": "^6.1.0"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "latest"
  }
}
