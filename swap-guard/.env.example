# Ethereum mainnet JSON-RPC endpoints, comma separated, tried in order. The
# keyless defaults work; a dedicated endpoint is faster and steadier.
ETH_RPC_URL=https://eth.drpc.org,https://mainnet.gateway.tenderly.co,https://ethereum-rpc.publicnode.com

# Block explorer. Account history comes from the Etherscan V2 API (chainid=1)
# when ETHERSCAN_API_KEY is set, falling back to the keyless Routescan and
# Blockscout Etherscan-compatible APIs, in that order. Address labels always
# come from Blockscout. A free Etherscan key is recommended for the demo.
ETHERSCAN_API_KEY=
BLOCKSCOUT_URL=https://eth.blockscout.com
# Optional Blockscout key (dev.blockscout.com) for higher rate limits.
BLOCKSCOUT_API_KEY=

# Intercepta (Web3 Antivirus) API. Without a key the Intercepta signals are
# shown as "not configured" and never count toward a verdict.
INTERCEPTA_API_KEY=
INTERCEPTA_API_URL=https://api.web3antivirus.io
# Cache Intercepta responses per address for 10 minutes. Set to "off" when
# recording the demo video so every call is live.
INTERCEPTA_CACHE=on

# Uniswap Trading API. Without a key the app quotes directly against the
# Uniswap v2 Router and v3 QuoterV2 contracts on mainnet.
UNISWAP_API_KEY=
UNISWAP_API_URL=https://trade-api.gateway.uniswap.org/v1
# Wallet passed as `swapper` in quote requests. Quotes are analysis only.
UNISWAP_SWAPPER=

# JEV. Either the TypeSafe endpoint (https://api.typesafe.ai/v1/systemone,
# model jev-latest) or the Vercel AI Gateway base URL
# (https://ai-gateway.vercel.sh/v1, model typesafe-ai/jev); "/evaluate" is
# appended to a base URL.
JEV_API_URL=https://api.typesafe.ai/v1/systemone
JEV_API_KEY=
JEV_MODEL=jev-latest
JEV_TIMEOUT_MS=1500

# Registered and frozen agents (comma separated) for rule H1.
MAAT_AGENTS=demo-agent
MAAT_FROZEN_AGENTS=
