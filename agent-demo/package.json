{
  "name": "maat-agent-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"tsx watch server.ts\" \"vite --host 0.0.0.0\"",
    "build": "tsc -p tsconfig.json && vite build",
    "start": "tsx server.ts",
    "deploy:validate": "node deploy.mjs --validate",
    "deploy": "node deploy.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/static": "^10.1.4",
    "@vitejs/plugin-react": "^4.3.4",
    "dotenv": "^18.0.4",
    "fastify": "^5.12.5",
    "react": "latest",
    "react-dom": "latest",
    "tsx": "^4.23.15",
    "vite": "^6.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "concurrently": "^10.0.5",
    "typescript": "latest"
  }
}
